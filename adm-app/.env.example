# Plantilla de configuración de Supabase para Huellitas App
# Copia este archivo como .env y edita con tus credenciales:
# cp .env.example .env

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=sb_publishable_tu_llave_publica

# Modo Mock / Offline:
# true  -> Usa datos mock en memoria sin llamar a Supabase
# false -> Conecta directamente a Supabase con las credenciales indicadas
FORZAR_MOCK=false
